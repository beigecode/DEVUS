# Anthropic API Key (required for AI token generation)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Solana RPC URL (Helius, QuickNode, or public RPC)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Deployer wallet private key (base58 encoded)
DEPLOYER_PRIVATE_KEY=your-base58-private-key

# Pinata JWT for IPFS uploads (optional - for token images/metadata)
PINATA_JWT_KEY=your-pinata-jwt

# Jito tip amount in lamports (optional - default 10000)
JITO_TIP_LAMPORTS=10000
